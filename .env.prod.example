# Скопируйте в .env.prod и заполните реальными значениями. Файл .env.prod в git не коммитить.

POSTGRES_DB=easyguide
POSTGRES_USER=easyguide
# сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=

# сгенерировать: openssl rand -base64 48 (минимум 32 байта для HS256)
APP_JWT_SECRET=

# реальный домен фронтенда, без завершающего слэша
APP_CORS_ALLOWED_ORIGIN=https://your-frontend-domain.example

# нужны только для docker-compose.prod.yml (Caddy, self-hosted VPS)
DOMAIN=api.your-domain.example
ACME_EMAIL=you@example.com
